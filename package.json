{
  "name": "today-tarot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tarot:generate": "node --import tsx scripts/tarot/generate.ts",
    "tarot:skeletons": "node --import tsx scripts/tarot/generate-skeletons.ts",
    "tarot:skeletons:validate": "node --import tsx scripts/tarot/validate-skeletons.ts",
    "tarot:validate": "node --import tsx scripts/tarot/validate.ts",
    "tarot:retry-failed": "node --import tsx scripts/tarot/retry-failed.ts",
    "tarot:status": "node --import tsx scripts/tarot/status.ts",
    "tarot:evaluate": "node --import tsx scripts/tarot/evaluate-interpretations.ts",
    "threads:assets": "node scripts/content/generate-threads-assets.mjs",
    "threads:copy": "node scripts/content/threads-copy.mjs",
    "tarot:assets": "node scripts/tarot/download-rws-assets.mjs"
  },
  "dependencies": {
    "motion": "13.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "happy-dom": "20.11.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
